from argparse import ArgumentParser

parser = ArgumentParser()
parser.add_argument('--sshfp', help='Print SSHFP records instead of a known_hosts file', action='store_true')
parser.add_argument('--static', help='Work with static keys instead of querying the Salt mine', action='store_true')
args = parser.parse_args()

if args.sshfp:
    from base64 import b64decode
    from hashlib import sha256

def mksshfp(host, keytype, key):
    if keytype == 'ssh-ed25519':
        keytype = 4
    elif keytype == 'ecdsa-sha2-nistp256':
        keytype = 3
    fingerprint = sha256(b64decode(key)).hexdigest().upper()
    #                                   v SHA256
    return f'{host}. IN SSHFP {keytype} 2 {fingerprint}'

def print_static():
  # hosts not collectable through the salt mine
  for host, keys in {
    'git.infra.opensuse.org': [
      'ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIqC55XDx9dVDBE776o30nvj9m9rMXlIV/44lrJYN1aJ',
      'ecdsa-sha2-nistp256 AAAAE2VjZHNhLXNoYTItbmlzdHAyNTYAAAAIbmlzdHAyNTYAAABBBHR5L8skm3nhekxrERN/g5yvMKVPwr5skdI3IBdRrqCYAQacgCmaslbQk2LhhrsHHDOg1DFQtlKY9nY4DHM+rhk=',
    ],
  }.items():
    for key in keys:
      if args.sshfp:
        key_type, key_data = key.split()
        print(mksshfp(host, key_type, key_data))
      else:
        print(f'{host} {key}')

def print_mine():
  import salt.client  # noqa E402, slows down ArgumentParser

  client = salt.client.LocalClient()
  this_minion = '{{ grains['fqdn'] }}'
  types = ['ed25519.pub', 'ecdsa.pub']

  all_keys = client.cmd(this_minion, 'mine.get', ['*'], kwarg={'fun': 'ssh_host_keys'}).get(this_minion, {})

  for minion, keys in all_keys.items():
      result = [keys.get(x, '').split()[:2] for x in types if x]
      for line in result:
          if args.sshfp:
              print(mksshfp(minion, line[0], line[1]))
          else:
              line = ' '.join(line)
              print(f'{minion} {line}')

if __name__ == '__main__':
  if args.static:
    print_static()
  else:
    print_mine()
