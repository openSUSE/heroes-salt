#!/bin/sh -efu
{#
vim: ft=sh.jinja noexpandtab
-#}{{ pillar['managed_by_salt'] }}

if [ "$(whoami)" != 'salt' ]
then
	echo 'This must be executed as the "salt" user.'
	exit 1
fi

cd {{ out_dir }}

git pull --quiet

{{ base_script }} > known_hosts

if [ -z "$(git status --porcelain)" ]
then
	echo 'Nothing to do.'
else
	git add known_hosts
	# TODO: commit signing
	#GNUPGHOME=/etc/salt/gpgkeys git commit -sm 'Scripted update'
	git commit -m 'Scripted update'
	git push origin main
fi
