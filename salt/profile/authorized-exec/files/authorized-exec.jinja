{{ pillar['managed_by_salt'] }}
(
	{%- for user, uconfig in salt['pillar.get']('profile:authorized-exec:' ~ config, {}).items() %}
		{%- if 'pubkey' in uconfig %}
			{%- set user = user ~ ':' ~ uconfig['pubkey'] %}
		{%- endif %}
	'{{ user }}' => [
		{%- for command in uconfig.get('commands', []) %}
		'{{ command }}',
		{%- endfor %}
	],
	{%- endfor %}
)
