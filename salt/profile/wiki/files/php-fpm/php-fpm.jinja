{%- set mypillar = salt['pillar.get']('mediawiki', {}) -%}
{{ pillar['managed_by_salt_ini'] }}

{%- for wiki, config in mypillar.get('wikis', {}) | dictsort %}
  {%- set version = config.get('version', mypillar.get('default_version')) %}
[wiki_{{ wiki }}]
apparmor_hat = wiki_{{ wiki }}

user = wwwrun
group = www
listen = /run/php-fpm/wiki_{{ wiki }}.sock
listen.owner = wwwrun
listen.group = www
listen.mode = 0600

env[MW_INSTALL_PATH] = /srv/www/{{ wiki }}.opensuse.org/public/
env[TMP] = /srv/www/{{ wiki }}.opensuse.org/tmp/

php_admin_flag[display_errors] = off
php_admin_flag[log_errors] = on

php_admin_value[memory_limit] = 16M
php_admin_value[open_basedir] = /srv/www/{{ wiki }}.opensuse.org/:/usr/share/mediawiki_{{ version }}:/dev/urandom:/bin/bash
php_admin_value[sendmail_path] = /usr/sbin/sendmail -t -i -f noreply+{{ wiki }}-wiki@opensuse.org
php_admin_value[session.save_path] = /srv/www/{{ wiki }}.opensuse.org/tmp/
php_admin_value[upload_max_filesize] = {{ mypillar['max_upload_size'] }}
php_admin_value[upload_tmp_dir] = /srv/www/{{ wiki }}.opensuse.org/tmp/

{#
  - below calculations are for 24 PHP vhosts (wikis)
-#}
pm = dynamic
{#-
  - machine has 11286M total memory
  - keep ~1G for other system processes
  - worker memory_limit is set to 16M above
  - ( 11286-1024 ) / 24 / 16 = ~ 27
  - overprovision (assuming not all wikis are always under full load) by rounding up to 35
#}
pm.max_children = 35
{#-
  - machine has 4 vCPU cores
  - 4 * 2
#}
pm.start_servers = 8
pm.min_spare_servers = 8
{#-
  - * 2
#}
pm.max_spare_servers = 16
{% endfor %}
