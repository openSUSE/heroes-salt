###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

 chain input_network_os-mirrorcache {
   jump global_internal

   ip6 saddr @net6_os-mirrorcache ip6 daddr @self6_mirrorcache ip6 nexthdr icmpv6 icmpv6 type { echo-request, echo-reply } accept

   log prefix "[avalon] MirrorCache Denied: " reject with icmpv6 type admin-prohibited
 }

 chain output_network_os-mirrorcache {
 }

