###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

 chain input_network_nat64 {
   #oif { } ip6 saddr $nat64_v6 accept #log prefix "[Tayga v6 Forward] " accept
   #oifname { } ip saddr $nat64_v4 accept #log prefix "[Tayga v4 Forward] " accept
 }
