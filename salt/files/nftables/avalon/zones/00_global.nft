###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

 chain global {
   ct state invalid drop
   ct state established, related accept
   iif lo accept
   oif lo accept

  ip6 saddr fe80::/10 ip6 daddr fe80::/10 ip6 nexthdr icmpv6 icmpv6 type { mld2-listener-report, nd-neighbor-advert, nd-neighbor-solicit } accept
 }

 chain global_internal {
   icmpv6 type { mld2-listener-report, nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, nd-router-advert } accept

   # ping
   ip6 daddr @host6_hel icmpv6 type { echo-reply, echo-request } accept
   ip6 daddr @host6_volva icmpv6 type { echo-reply, echo-request } accept

   # core services (to hel)
   ip6 daddr @host6_hel tcp dport { domain, https, ntp, smtp } accept
   ip6 daddr @host6_hel udp dport { domain, ntp } accept

   # Salt (to volva)
   ip6 daddr @host6_volva tcp dport 4505-4506 accept

   # repositories (to download)
   ip6 daddr @host6_download tcp dport { http, https } accept

   # Syslog (to monitor and logger)
   ip6 daddr @host6_monitor udp dport syslog accept
   ip6 daddr @host6_monitor tcp dport 514 accept
   ip6 daddr @host6_logger-prg tcp dport 514 accept

   # reject UDP for traceroute but exempt ports used otherwise
   udp dport != { 53, 123, 514 } ip protocol udp log prefix "[UDP Rejected] " reject
   udp dport != { 53, 1053, 123, 514, 3780, 6277, 60000-61000 } ip6 nexthdr udp log prefix "[UDP Rejected] " reject
 }

 chain global_internal_legacy {
   # reference traceroute comment in global_internal
   udp dport != { 53, 123, 514 } ip protocol udp log prefix "[UDP Rejected] " reject
 }

