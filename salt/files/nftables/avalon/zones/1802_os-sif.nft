###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

 chain input_network_os-sif {
   jump global_internal
   ip6 nexthdr icmpv6 accept

   # sif within SLC1
   ip6 saddr @host6_sif ip6 daddr @lan_ipv6_slc1 tcp dport ssh log prefix "[avalon] Sif SSH Allowed: " accept
   ip6 saddr @host6_sif ip6 daddr @self6_sif tcp dport ssh accept

   log prefix "[avalon] Sif Denied: " reject with icmpx type admin-prohibited
 }

 chain output_network_os-sif {
 }

