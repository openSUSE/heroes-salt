###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

 chain input_network_os-devcon {
   jump global_internal

   ip6 saddr @net6_os-devcon ip6 daddr @self6_devcon ip6 nexthdr icmpv6 icmpv6 type { echo-request, echo-reply } accept

   log prefix "[avalon] Devcon Denied: " reject with icmpv6 type admin-prohibited
 }

