###################################################
## MANAGED BY SALT in salt/files/nftables/asgard ##
###################################################

chain input_network_prg2 {
  ip6 saddr fe80::/10 ip6 daddr { fe80::/10, ff00::/10 } icmpv6 type { mld2-listener-report, nd-neighbor-advert, nd-neighbor-solicit } accept
  ip6 saddr fe80::/10 ip6 daddr { fe80::/10, ff00::/10 } ip6 nexthdr ospfigp accept
  ip6 saddr @host6_p2p_asgard ip6 daddr @self6_p2p_prg2_asgard icmpv6 type { echo-reply, echo-request } accept

  # monitor -> Prometheus node exporters (consider removing once local collection is in place)
  ip6 saddr @host6_monitor ip6 daddr @lan_ipv6 tcp dport 9100 accept
  ip6 saddr @host6_monitor ip6 daddr @host6_avalon tcp dport 9100 accept

  # from PRG2/Thor
  ip6 saddr @host6_thor ip6 daddr @self6_p2p_prg2_asgard icmpv6 type { echo-reply, echo-request } accept
  ip6 saddr @host6_thor ip6 daddr @self6_p2p_prg2_asgard tcp dport ssh accept
  ip6 saddr @host6_thor ip6 daddr @host6_volva icmpv6 type { echo-reply, echo-request } accept
  ip6 saddr @host6_thor ip6 daddr @host6_volva tcp dport ssh accept

  # gitlab-runner* -> Salt Masters (rsync for Salt repository deployment)
  ip6 saddr @host6_gitlab-runner ip6 daddr @host6_volva tcp dport rsync accept

  # acme -> certificate deployment targets
  ip6 saddr @host6_acme ip6 daddr @host6_volva icmpv6 type { echo-reply, echo-request } accept
  ip6 saddr @host6_acme ip6 daddr @host6_volva tcp dport ssh accept

  log prefix "[avalon] PRG2 Denied: " reject with icmpv6 type admin-prohibited
}

chain output_network_prg2 {
  ip6 saddr fe80::/10 ip6 daddr { fe80::/10, ff00::/10 } icmpv6 type { mld2-listener-report, nd-neighbor-advert, nd-neighbor-solicit } accept
  ip6 saddr fe80::/10 ip6 daddr { fe80::/10, ff00::/10 } ip6 nexthdr ospfigp accept

  jump global_internal
}
