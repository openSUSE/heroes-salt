###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

 chain input_network_os-public {
   jump global_internal

   icmpv6 type { echo-reply, echo-request } limit rate 5/second accept

   ip6 saddr @net6_os-public ip6 daddr @self6_public ip6 nexthdr icmpv6 icmpv6 type { echo-request, echo-reply } accept

   # Globus -> backends
   ip6 saddr @host6_globus ip6 daddr @host6_slc-mirror tcp dport http accept
   ip6 saddr @host6_globus ip6 daddr @host6_slc-mirror tcp dport rsync accept
   ip6 saddr @host6_globus ip6 daddr @host6_slc-mirror tcp dport 874 accept
   ip6 saddr @host6_globus ip6 daddr @host6_mirrorcache-us tcp dport 3000 accept
   ip6 saddr @host6_globus ip6 daddr @host6_debuginfod tcp dport 8002 accept

   log prefix "[avalon] Public Denied: " reject with icmpv6 type admin-prohibited
 }

