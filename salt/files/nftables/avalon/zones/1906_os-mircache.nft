###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

 chain input_network_os-mircache {
   jump global_internal

   ip6 saddr @net6_os-mircache ip6 daddr @self6_mircache ip6 nexthdr icmpv6 icmpv6 type { echo-request, echo-reply } accept

   # mirrorcache-us-db: mirror scanning, mirrorcache-us: https://github.com/openSUSE/MirrorCache/issues/545
   oif os-p2p-pub ip6 saddr @host6_mirrorcache-us-all ip6 daddr != @lan_ipv6_slc1_nonat tcp dport { http, https } accept
   oif os-p2p-pub ip6 saddr @host6_mirrorcache-us-all ip6 daddr != @lan_ipv6_slc1_nonat icmpv6 type { echo-request, echo-reply } accept
   oif os-p2p-pub ip saddr @host4_mirrorcache-us-db ip daddr != @lan_ipv4 tcp dport { http, https } accept
   oif os-p2p-pub ip saddr @host4_mirrorcache-us-db ip daddr != @lan_ipv4 icmp type { echo-request, echo-reply } accept
   # mirror scanning of slc-mirror.o.o
   oif os-public ip6 saddr @host6_mirrorcache-us-db ip6 daddr @host6_globus tcp dport { http, https } accept
   oif os-public ip6 saddr @host6_mirrorcache-us-db ip6 daddr @host6_globus icmpv6 type { echo-request, echo-reply } accept

   log prefix "[avalon] MirrorCache Denied: " reject with icmpv6 type admin-prohibited
 }

 chain output_network_os-mircache {
 }

