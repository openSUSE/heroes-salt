###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

 chain input_network_os-p2p-pub {
   #ip saddr @net4_blacklist drop

   ip6 daddr @self6_p2p ip6 nexthdr icmpv6 limit rate 3/second accept
   ip daddr @self4_p2p ip protocol icmp limit rate 3/second accept

   # remote routers -> avalon{1,2} WireGuard
   ip6 saddr @host6_wan_asgard ip6 daddr @self6_p2p udp dport { 52471, 52472 } accept
   ip6 saddr @host6_wan_stonehat ip6 daddr @self6_p2p udp dport 52462 accept

   # from the internet to os-public/Globus
   #  ping
   ip6 daddr @host6_globus ip6 nexthdr icmpv6 icmpv6 type { echo-request, echo-reply } limit rate 1/second accept
   ip daddr @host4_globus ip protocol icmp icmp type { echo-request, echo-reply } limit rate 1/second accept

   #  http(s)
   ip6 daddr @host6_globus tcp dport { http, https } accept
   ip daddr @host4_globus tcp dport { http, https } accept

   #  rsync
   ip6 daddr @host6_globus tcp dport rsync accept
   ip daddr @host4_globus tcp dport rsync accept

   # from the internet to os-public/slc-ns
   #   ping
   ip6 daddr @host6_slc-ns icmpv6 type { echo-reply, echo-request } limit rate 1/second accept
   ip daddr @host4_slc-ns icmp type { echo-reply, echo-request } limit rate 1/second accept
   #   DNS
   ip6 daddr @host6_slc-ns udp dport domain accept
   ip6 daddr @host6_slc-ns tcp dport domain accept
   ip daddr @host4_slc-ns udp dport domain accept
   ip daddr @host4_slc-ns tcp dport domain accept

   # traceroute
   ip protocol udp reject
   ip6 nexthdr udp reject

   drop
 }

 chain output_network_os-p2p-pub {
   jump global

   # asgard{1,2} -> avalon{1,2} WireGuard
   ip6 saddr @self6_p2p ip6 daddr @host6_wan_asgard udp dport 52461 accept
 }

