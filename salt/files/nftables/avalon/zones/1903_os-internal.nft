###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

 chain input_network_os-internal {
   jump global_internal

   ip6 saddr @net6_os-internal ip6 daddr @self6_internal ip6 nexthdr icmpv6 icmpv6 type { echo-request, echo-reply } accept

   # Tyr -> NTP (for upstream pool access)
   oif os-p2p-pub ip6 saddr @host6_tyr udp dport ntp accept

   log prefix "[avalon] Internal Denied: " reject with icmpv6 type admin-prohibited
 }

 chain output_network_os-internal {
 }

