###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################
{#-
vim:filetype=nftables.jinja
-#}

{%- set chainmap = {
          'iif': 'input',
          'oif': 'output',
        }
%}

 chain forward {
   type filter hook forward priority 0
   policy drop

   jump common_synproxy
   jump global

{% for x in ['iif', 'oif'] %}
  {{ x }} vmap {
    {%- if x == 'iif' %}
    os-avalon                      : jump network_os-avalon,
    os-p2p-pub                     : jump input_network_os-p2p-pub,
    {%- endif %}
    {%- for network, network_config in pillar['networks']['sites']['slc1'].items() | sort(attribute='1.short') %}
      {%- set shortnet = network_config['short'] %}
    {{ shortnet }} {{ ( ': jump ' ~ chainmap[x] ~ '_network_' ~ shortnet ) | indent(30 - shortnet | length, true) }},
    {%- endfor %}
  }
{% endfor %}

   iifname prg2_asgard jump input_network_prg2

   # Tayga (-> zones/05_nat64.nft)
   iifname nat64 jump input_network_nat64

   iif != os-p2p-pub log prefix "[avalon] Forward Dropped: " flags all
 }
