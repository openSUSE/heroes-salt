###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

 # input chain for traffic towards the local system (i.e. this firewall itself)
 chain input {
   type filter hook input priority 0
   policy drop

   jump global

   iif vmap {
     os-avalon    : jump network_os-avalon,
     os-avalon-ct : jump network_os-avalon,
     os-bare      : jump input_network_os-bare,
     os-devcon    : jump input_network_os-devcon,
     os-p2p-pub   : jump input_network_os-p2p-pub,
     os-s-warp    : jump input_network_os-s-warp,
     os-salt      : jump input_network_os-salt,
     os-sif       : jump input_network_os-sif,
   }

   iif != os-p2p-pub log prefix "[avalon] Inbound Dropped: " flags all
   counter reject
 }

