###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################
{#-
vim:filetype=nftables.jinja
#}

{%- set networks = pillar['networks'] %}

{% for site, site_networks in networks['sites'].items() %}
###
#  BEGIN: {{ site | upper }}
###
    {%- for with_nat in [true, false] %}
set lan_ipv6_{{ site }}{{ '' if with_nat else '_nonat' }} {
  type ipv6_addr
  flags interval
  auto-merge
  elements = {
    {%- for network, network_config in site_networks.items() %}
    {{ network_config['net6'] }},
    {%- endfor %}
    {%- if with_nat %}
    {{ networks['pseudos'][site]['openSUSE-NAT64-Pool']['net6'] }},
    {%- endif %}
  }
}
    {%- endfor %}
{{ '' }}
{%- if site == 'slc1' %}
  {%- for network, network_config in site_networks.items() %}
# VLAN {{ network_config['id'] }} ({{ network }})
    {%- for i in [6, 4] %}
      {%- set net = 'net' ~ i | string %}
      {%- if net in network_config %}
set {{ net }}_{{ network_config['short'] }} {
  type ipv{{ i }}_addr
  flags interval
  elements = {
    {{ network_config[net] }}
  }
}
    {%- endif %}  {#- close IP family check #}
   {%- endfor %}  {#- close IP family loop #}
set self6_{{ network_config['short'].replace('os-', '') }} {
  type ipv6_addr
  flags interval
  elements = {
    {%- set gw6 = network_config['gw6'] %}
    {%- if gw6.endswith('::3') %}
    {{ gw6[:-1] }}1/128,
    {{ gw6[:-1] }}2/128,
    {%- endif %}
    {{ gw6 }}/128,
  }
}
  {%- endfor %}   {#- close site_networks loop #}
{%- endif %}      {#- close site check #}
###
#  END: {{ site | upper }}
###
{% endfor %}

set lan_ipv4 {
  type ipv4_addr
  flags interval
  auto-merge
  elements = {
    172.16.112.0/30,    # os-avalon
    172.16.113.0/28,    # os-public
    172.16.127.0/25,    # NAT64
    195.135.220.40/29,  # os-p2p-pub
  }
}

# WAN networks
set net6_os-internet {
  type ipv6_addr
  flags interval
  elements = {
    $net6_internet,
  }
}
set net4_os-internet {
  type ipv4_addr
  flags interval
  elements = {
    $net4_internet,
  }
}

# WAN addresses
set net4_internet1 {
  type ipv4_addr
  flags interval
  elements = {
    $net4_internet1,
  }
}

## This firewall

set self6_p2p {
  type ipv6_addr
  flags interval
  elements = {
    2a07:de40:617f:201::11/128,  # avalon1
    2a07:de40:617f:201::12/128,  # avalon2
    2a07:de40:617f:201::1/128,   # avalon HA VIP
  }
}
set self4_p2p {
  type ipv4_addr
  flags interval
  elements = {
    195.135.220.44/32,  # avalon1
    195.135.220.45/32,  # avalon2
    195.135.220.41/32,  # avalon HA VIP
  }
}

# PRG2
