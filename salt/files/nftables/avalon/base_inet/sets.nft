###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

set lan_ipv6 {
  type ipv6_addr
  flags interval
  auto-merge
  elements = {
    $net6_nat64,
    $net6_os-bare,
    $net6_os-devcon,
    $net6_os-salt,
    $net6_os-sif,
  }
}

set lan_ipv6_nonat {
  type ipv6_addr
  flags interval
  auto-merge
  elements = {
    $net6_os-bare,
    $net6_os-devcon,
    $net6_os-salt,
    $net6_os-sif,
  }
}

## Networks

# VLAN 1800 openSUSE-bare
set net6_os-bare {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-bare,
  }
}

# VLAN 1801 openSUSE-devcon
set net6_os-devcon {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-devcon,
  }
}

# VLAN 1801 openSUSE-sif
set net6_os-sif {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-sif,
  }
}

# VLAN 1803 openSUSE-SUSE-warp
set net6_os-s-warp {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-s-warp,
  }
}

# VLAN 1900 openSUSE-salt
set net6_os-salt {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-salt,
  }
}

# WAN networks
set net6_os-internet {
  type ipv6_addr
  flags interval
  elements = {
    $net6_internet,
  }
}
set net4_os-internet {
  type ipv4_addr
  flags interval
  elements = {
    $net4_internet,
  }
}

# WAN addresses
set net4_internet1 {
  type ipv4_addr
  flags interval
  elements = {
    $net4_internet1,
  }
}

## This firewall

set self6_p2p {
  type ipv6_addr
  flags interval
  elements = {
    2a07:de40:617f:201::11/128,  # avalon1
    2a07:de40:617f:201::12/128,  # avalon2
    2a07:de40:617f:201::1/128,   # avalon HA VIP
  }
}
set self4_p2p {
  type ipv4_addr
  flags interval
  elements = {
    195.135.220.44/32,  # avalon1
    195.135.220.45/32,  # avalon2
    195.135.220.41/32,  # avalon HA VIP
  }
}

# PRG2
set self6_p2p_prg2_asgard {
  type ipv6_addr
  flags interval
  elements = {
    fda1:21af:580f:1::/128,  # avalon1
    fda1:21af:580f:1::2/128, # avalon2
  }
}
set self4_p2p_prg2_asgard {
  type ipv4_addr
  flags interval
  elements = {
    172.16.112.0/32, # avalon1
    172.16.112.2/32, # avalon2
  }
}

