###################################################
## MANAGED BY SALT in salt/files/nftables/avalon ##
###################################################

set lan_ipv6 {
  type ipv6_addr
  flags interval
  auto-merge
  elements = {
    $net6_nat64,
    $net6_os-bare,
    $net6_os-dbginfod,
    $net6_os-devcon,
    $net6_os-internal,
    $net6_os-mircache,
    $net6_os-mirror,
    $net6_os-public,
    $net6_os-salt,
    $net6_os-sif,
  }
}

set lan_ipv6_nonat {
  type ipv6_addr
  flags interval
  auto-merge
  elements = {
    $net6_os-bare,
    $net6_os-dbginfod,
    $net6_os-devcon,
    $net6_os-internal,
    $net6_os-mircache,
    $net6_os-mirror,
    $net6_os-public,
    $net6_os-salt,
    $net6_os-sif,
  }
}

set lan_ipv4 {
  type ipv4_addr
  flags interval
  auto-merge
  elements = {
    172.16.112.0/30,    # os-avalon
    172.16.113.0/28,    # os-public
    172.16.127.0/25,    # NAT64
    195.135.220.40/29,  # os-p2p-pub
  }
}

## Networks

# VLAN 1800 openSUSE-bare
set net6_os-bare {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-bare,
  }
}

# VLAN 1801 openSUSE-devcon
set net6_os-devcon {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-devcon,
  }
}

# VLAN 1801 openSUSE-sif
set net6_os-sif {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-sif,
  }
}

# VLAN 1803 openSUSE-SUSE-warp
set net6_os-s-warp {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-s-warp,
  }
}

# VLAN 1900 openSUSE-salt
set net6_os-salt {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-salt,
  }
}

# VLAN 1903 openSUSE-internal
set net6_os-internal {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-internal,
  }
}

# VLAN 1904 openSUSE-public
set net6_os-public {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-public,
  }
}
set net4_os-public {
  type ipv4_addr
  flags interval
  elements = {
    $net4_os-public,
  }
}

# VLAN 1905 openSUSE-mirror
set net6_os-mirror {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-mirror,
  }
}

# VLAN 1906 openSUSE-mirrorcache
set net6_os-mircache {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-mircache,
  }
}

# VLAN 1907 openSUSE-debuginfod
set net6_os-dbginfod {
  type ipv6_addr
  flags interval
  elements = {
    $net6_os-dbginfod,
  }
}

# WAN networks
set net6_os-internet {
  type ipv6_addr
  flags interval
  elements = {
    $net6_internet,
  }
}
set net4_os-internet {
  type ipv4_addr
  flags interval
  elements = {
    $net4_internet,
  }
}

# WAN addresses
set net4_internet1 {
  type ipv4_addr
  flags interval
  elements = {
    $net4_internet1,
  }
}

## This firewall

set self6_p2p {
  type ipv6_addr
  flags interval
  elements = {
    2a07:de40:617f:201::11/128,  # avalon1
    2a07:de40:617f:201::12/128,  # avalon2
    2a07:de40:617f:201::1/128,   # avalon HA VIP
  }
}
