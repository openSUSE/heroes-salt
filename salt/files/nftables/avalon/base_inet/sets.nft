## Other, outside, hosts

# SUSE firewall (gatweway from avalon to the outside)
set host4_suse_gw {
  type ipv4_addr
  flags interval
  elements = {
    195.135.220.46/32,
  }
}
set host6_suse_gw {
  type ipv6_addr
  flags interval
  elements = {
    2a07:de40:617f:201:ffff:ffff:ffff:ffff/128,
  }
}

# asgard{1,2}.i.o.o over the internet to os-p2p-pub
set host6_wan_asgard {
  type ipv6_addr
  flags interval
  elements = {
    2a07:de40:b27f:201::11/128,
    2a07:de40:b27f:201::12/128,
  }
}

# asgard{1,2}.i.o.o (via P2P network)
set host6_p2p_asgard {
  type ipv6_addr
  flags interval
  elements = {
    fda1:21af:580f:1::1/128, # asgard1
    fda1:21af:580f:1::3/128, # asgard2
  }
}
set host4_p2p_avalon {
  type ipv4_addr
  flags interval
  elements = {
    172.16.112.0/32, # avalon1
    172.16.112.2/32, # avalon2
  }
}

