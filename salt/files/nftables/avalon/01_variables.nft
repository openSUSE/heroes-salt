{#-
vim:filetype=nftables.jinja
#}

# SUSE
define net6_os-p2p-pub = 2a07:de40:617f:201::/64
define net4_os-p2p-pub = 195.135.220.40/29

# VLAN 1700 openSUSE-avalon-cluster
define net6_os-avalon = fd03:7bbf:d626:1700::/64
define net4_os-avalon = 172.16.112.0/30

# VLAN 1701 openSUSE-avalon-cluster-conntrack
define net6_os-avalon-ct = fd03:7bbf:d626:1701::/64

{%- set networks = pillar['networks'] %}
{%- for network, network_config in networks['sites']['slc1'].items() %}

# VLAN {{ network_config['id'] }} {{ network }}
  {%- for i in [6, 4] %}
    {%- set net = 'net' ~ i | string %}
    {%- if net in network_config %}
define {{ net }}_{{ network_config['short'] }}{{ ( '= ' ~ network_config[net] ) | indent(15 - network_config['short'] | length, true) }}
    {%- endif %}
  {%- endfor %}

{%- endfor %}

# WAN
define net4_internet = 195.135.220.48/28
define net6_internet = 2a07:de40:617e::/48

# WAN (allocated)
#   public for generic traffic to the internet
define net4_internet1 = 195.135.220.49
#   public for traffic from os-public to the internet and from the internet to Globus
define net4_internet2 = 195.135.220.50
#   public for traffic from the internet to slc-ns1
define net4_internet5 = 195.135.220.53
#   public for traffic from the internet to slc-ns2
define net4_internet6 = 195.135.220.54

# NAT64
{%- set nat64_config = networks['pseudos']['slc1']['openSUSE-NAT64-Pool'] %}
define net6_nat64         = {{ nat64_config['net6'] }}
define net4_nat64         = {{ nat64_config['net4'] }}

