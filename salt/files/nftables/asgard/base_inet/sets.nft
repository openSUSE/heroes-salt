###################################################
## MANAGED BY SALT in salt/files/nftables/asgard ##
###################################################
{#-
vim:filetype=nftables.jinja
#}

# This file has three sections:
# 1. Networks (VLANs)
# 2. Addresses of this firewall cluster
# 3. Addresses of other hosts

{%- set networks = pillar['networks'] %}

{% for site, site_networks in networks['sites'].items() %}
###
#  BEGIN: {{ site | upper }}
###
    {%- for with_nat in [true, false] %}
set lan_ipv6_{{ site }}{{ '' if with_nat else '_nonat' }} {
  type ipv6_addr
  flags interval
  auto-merge
  elements = {
    {%- for network, network_config in site_networks.items() %}
    {{ network_config['net6'] }},
    {%- endfor %}
    {%- if site == 'prg2' %}
    $host6_qsc-ns3,
    $host6_slimhat,
    {%- endif %}
    {%- if with_nat %}
    {{ networks['pseudos'][site]['openSUSE-NAT64-Pool']['net6'] }},
    {%- endif %}
  }
}
    {%- endfor %}
{{ '' }}
{%- if site == 'prg2' %}
  {%- for network, network_config in site_networks.items() %}
# VLAN {{ network_config['id'] }} ({{ network }})
    {%- for i in [6, 4] %}
      {%- set net = 'net' ~ i | string %}
      {%- if net in network_config %}
set {{ net }}_{{ network_config['short'] }} {
  type ipv{{ i }}_addr
  flags interval
  elements = {
    {{ network_config[net] }}
  }
}
    {%- endif %}  {#- close IP family check #}
   {%- endfor %}  {#- close IP family loop #}
set self6_{{ network_config['short'].replace('os-', '') }} {
  type ipv6_addr
  flags interval
  elements = {
    {%- set gw6 = network_config['gw6'] %}
    {%- if gw6.endswith('::3') %}
    {{ gw6[:-1] }}1/128,
    {{ gw6[:-1] }}2/128,
    {%- endif %}
    {{ gw6 }}/128,
  }
}
  {%- endfor %}   {#- close site_networks loop #}
{%- endif %}      {#- close site check #}
###
#  END: {{ site | upper }}
###
{% endfor %}

set vpn_ipv6 {
    type ipv6_addr
    flags interval
    auto-merge
    elements = {
        $net6_vpn-udp,
        $net6_vpn-tcp
    }
}

