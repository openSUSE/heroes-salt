###################################################
## MANAGED BY SALT in salt/files/nftables/asgard ##
###################################################
{#-
vim:filetype=nftables.jinja
-#}

{%- set site_networks = pillar['networks']['sites'] %}

 # input chain, this is for traffic targeted towards the local system (i.e. this firewall itself)
 chain input {
  type filter hook input priority 0
  policy drop

  jump global


  iif vmap {
    os-asgard                      : jump network_os-asgard,
    os-p2p-pub                     : jump input_network_os-p2p-pub,
    {%- for network, network_config in site_networks['prg2'].items() | sort(attribute='1.short') %}
      {%- set shortnet = network_config['short'] %}
    {{ shortnet }} {{ ( ': jump input_network_' ~ shortnet ) | indent(30 - shortnet | length, true) }},
    {%- endfor %}
  }


  # WireGuard interfaces not using iif to prevent breakage on tunnel restarts
  iifname nueqsc_stonehat jump input_network_nueqsc
  iifname @if_s2s_slc1 jump input_network_slc1

  ip6 saddr fe80::/10 log prefix "[asgard ll] Inbound Dropped: " flags all
  iif != os-p2p-pub log prefix "[asgard] Inbound Dropped: " flags all
  counter reject
 }

