###################################################
## MANAGED BY SALT in salt/files/nftables/asgard ##
###################################################

 chain input_network_os-ghr-c {
  jump global_internal

  # no realistic limitations possible due to setup of Docker registry and GitHub
  oif os-p2p-pub ip6 saddr @host6_apollo_c ip6 daddr != @lan_ipv6_prg2_nonat icmpv6 type { echo-reply, echo-request } accept
  oif os-p2p-pub ip6 saddr @host6_apollo_c ip6 daddr != @lan_ipv6_prg2_nonat tcp dport https accept
  oifname nat64 ip6 saddr @host6_apollo_c ip6 daddr != @lan_ipv6_prg2_nonat icmpv6 type { echo-reply, echo-request } accept
  oifname nat64 ip6 saddr @host6_apollo_c ip6 daddr != @lan_ipv6_prg2_nonat tcp dport https accept

  jump acl_internet_github

  log prefix "[GHR-C Denied] " reject with icmpv6 type admin-prohibited
 }

 chain output_network_os-ghr-c {
 }
