###################################################
## MANAGED BY SALT in salt/files/nftables/asgard ##
###################################################

 chain network_os-asgard {
  jump global_internal

  # SSH
  ip6 saddr $net6_os-asgard ip6 daddr $net6_os-asgard tcp dport ssh accept

  # ICMP (echo, neighbor discovery, etc.), OSPF (BIRD), VRRP (Keepalived),
  ip6 nexthdr { icmpv6, ospfigp, vrrp } accept
  ip protocol vrrp accept

  # conntrackd
  ip6 nexthdr udp udp dport 3780 accept

  # for reaching a remote non-primary firewall through a local non-primary firewall
  # for example, if asgard1 and avalon1 are masters, reaching avalon2 from thor requires forwarding via asgard2 over os-asgard
  oifname slc1_avalon ip6 saddr @host6_thor ip6 daddr @host6_p2p_avalon icmpv6 type { echo-reply, echo-request } accept
  oifname slc1_avalon ip6 saddr @host6_thor ip6 daddr @host6_p2p_avalon tcp dport ssh accept

  # TODO: drop
  log prefix "[asgard misc] " accept
 }
