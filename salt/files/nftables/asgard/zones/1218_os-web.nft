###################################################
## MANAGED BY SALT in salt/files/nftables/asgard ##
###################################################

 chain input_network_os-web {
  jump global_internal

  ip6 saddr $net6_os-web ip6 daddr @self6_web ip6 nexthdr icmpv6 accept

  oif os-p2p-pub ip6 saddr $host6_quiz ip6 daddr @cloud6_npmjs icmpv6 type { echo-request, echo-reply } accept
  oif os-p2p-pub ip6 saddr $host6_quiz ip6 daddr @cloud6_npmjs tcp dport https accept

  jump acl_internet_github
  jump acl_internet_obs_login
  jump acl_internet_registry_suse

  log prefix "[Web Denied] " reject with icmpv6 type admin-prohibited
 }

 chain output_network_os-web {
 }
