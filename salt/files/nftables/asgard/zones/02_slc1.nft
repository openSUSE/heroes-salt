###################################################
## MANAGED BY SALT in salt/files/nftables/asgard ##
###################################################

chain input_network_slc1 {
  ip6 saddr fe80::/10 ip6 daddr { fe80::/10, ff00::/10 } icmpv6 type { mld2-listener-report, nd-neighbor-advert, nd-neighbor-solicit } accept
  ip6 saddr fe80::/10 ip6 daddr { fe80::/10, ff00::/10 } ip6 nexthdr ospfigp accept
  ip6 saddr @host6_p2p_avalon ip6 daddr @self6_p2p_slc1_avalon icmpv6 type { echo-reply, echo-request } accept

  jump global_internal

  # remote Salt Masters -> GitLab
  oif os-internal ip6 saddr @host6_volva ip6 daddr $host6_mickey tcp dport https accept
  oif os-internal ip6 saddr @host6_volva-nw ip6 daddr $host6_mickey tcp dport https accept

  # remote Salt Syndics -> Master of Masters
  oif os-salt ip6 saddr @host6_volva ip6 daddr @host6_seidr icmpv6 type { echo-reply, echo-request } accept
  oif os-salt ip6 saddr @host6_volva ip6 daddr @host6_seidr tcp dport 4505-4506 accept
  oif os-salt ip6 saddr @host6_volva-nw ip6 daddr @host6_seidr icmpv6 type { echo-reply, echo-request } accept
  oif os-salt ip6 saddr @host6_volva-nw ip6 daddr @host6_seidr tcp dport 4505-4506 accept

  # remote GitLab Runners
  oif os-internal ip6 saddr @host6_gitlab-runner_slc ip6 daddr $host6_mickey tcp dport https accept
  oif os-salt ip6 saddr @host6_gitlab-runner_slc ip6 daddr @host6_seidr icmpv6 type { echo-reply, echo-request } accept
  oif os-salt ip6 saddr @host6_gitlab-runner_slc ip6 daddr @host6_seidr tcp dport 4550 accept
  oif os-salt ip6 saddr @host6_gitlab-runner_slc ip6 daddr $host6_witch1 icmpv6 type { echo-reply, echo-request } accept
  oif os-salt ip6 saddr @host6_gitlab-runner_slc ip6 daddr $host6_witch1 tcp dport rsync accept

  # globus reverse proxy -> jekyll (until we have a local copy of jekyll sites in SLC1)
  oif os-internal ip6 saddr @host6_globus ip6 daddr $host6_jekyll tcp dport http accept

  # nameservers -> chip (DNS query/AXFR)
  oif os-internal ip6 saddr @host6_slc-ns ip6 daddr $host6_chip icmpv6 type { echo-reply, echo-request } accept
  oif os-internal ip6 saddr @host6_slc-ns ip6 daddr $host6_chip udp dport domain accept
  oif os-internal ip6 saddr @host6_slc-ns ip6 daddr $host6_chip tcp dport domain accept
}

chain output_network_slc1 {
  ip6 saddr fe80::/10 ip6 daddr { fe80::/10, ff00::/10 } icmpv6 type { mld2-listener-report, nd-neighbor-advert, nd-neighbor-solicit } accept
  ip6 saddr fe80::/10 ip6 daddr { fe80::/10, ff00::/10 } ip6 nexthdr ospfigp accept
}
