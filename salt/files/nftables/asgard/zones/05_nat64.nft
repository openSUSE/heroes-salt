###################################################
## MANAGED BY SALT in salt/files/nftables/asgard ##
###################################################

chain input_network_nat64 {
  oif { os-salt, os-internal, os-thor, os-odin, os-log } ip6 saddr $nat64_v6 accept #log prefix "[Tayga v6 Forward] " accept
  oifname nueqsc_stonehat ip saddr $nat64_v4 accept #log prefix "[Tayga v4 Forward] " accept
  oifname os-public ip6 saddr { 2a07:de40:b27e:0064:0000:0000:c0a8:2f66/128, 2a07:de40:b27e:0064:0000:0000:c0a8:2f65/128 } ip6 daddr @host6_atlas tcp dport { http, https } accept

  oif os-p2p-pub ip saddr $nat64_v4 ip daddr != @net4_internal ip protocol icmp icmp type { echo-request, echo-reply } accept
  oif os-p2p-pub ip saddr $nat64_v4 ip daddr != @net4_internal tcp dport { http, https, ssh } accept

  # Matrix federation, see v6 explanation in 1203_os-internal.nft
  oif os-p2p-pub ip saddr $host4_matrix ip daddr != @net4_internal ip protocol tcp accept
}
