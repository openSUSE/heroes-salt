###################################################
## MANAGED BY SALT in salt/files/nftables/asgard ##
###################################################

 chain input_network_os-code-dev {
  jump global_internal

  ip6 saddr @net6_os-code-dev ip6 daddr @self6_code-dev ip6 nexthdr icmpv6 accept
  ip6 saddr @net6_os-thor ip6 daddr @net6_os-code-dev tcp dport ssh accept

  # MySQL
  ip6 saddr $host6_code-dev ip6 daddr $host6_hel ip6 nexthdr icmpv6 icmpv6 type { echo-request, echo-reply } accept
  ip6 saddr $host6_code-dev ip6 daddr $host6_hel tcp dport 3307 accept

  reject with icmpv6 type admin-prohibited
 }

 chain output_network_os-code-dev {
  jump global_internal

 }
