define self6_salt        = { 2a07:de40:b27e:1200::1/128, 2a07:de40:b27e:1200::2/128, 2a07:de40:b27e:1200::3/128 }
define self6_bare        = { 2a07:de40:b27e:1201::1/128, 2a07:de40:b27e:1201::2/128, 2a07:de40:b27e:1201::3/128 }
