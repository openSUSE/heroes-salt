.test_highstate:
  image: registry.opensuse.org/opensuse/infrastructure/containers/heroes-salt-testing-systemd:latest
  stage: test
  before_script:
    - bin/prepare_test_env.sh -g -s -m -n
  tags:
    - docker
  artifacts:
    when: always
    paths:
      - '*.txt'
      - 'render/*.txt'
  retry:
    max: 1
    when: script_failure
  rules:
    - when: on_success

{% for role in roles %}
test_highstate_{{ role }}:
  extends:
    - .test_highstate
  script: bin/test_highstate.sh {{ role }}
{% endfor %}
